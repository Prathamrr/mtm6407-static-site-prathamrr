---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Home">

<section class="bg-primary text-white py-5">

<div class="container text-center">

<h1 class="display-4 fw-bold">
Hi, I'm Pratham
</h1>

<p class="lead">
Web Developer • UI Designer • WordPress Expert
</p>

<a href="/projects" class="btn btn-light btn-lg mt-3">
View My Work
</a>

</div>

</section>

<section class="py-5">

<div class="container">

<h2 class="mb-4">
My Skills
</h2>

<div class="row">

<div class="col-md-4">

<div class="card shadow">

<div class="card-body">

<h4>Frontend</h4>

<p>
HTML, CSS, Bootstrap, JavaScript, React
</p>

</div>

</div>

</div>

<div class="col-md-4">

<div class="card shadow">

<div class="card-body">

<h4>Backend</h4>

<p>
PHP, Node.js, MySQL
</p>

</div>

</div>

</div>

<div class="col-md-4">

<div class="card shadow">

<div class="card-body">

<h4>CMS</h4>

<p>
WordPress Development & SEO
</p>

</div>

</div>

</div>

</div>

</div>

</section>

</MainLayout>