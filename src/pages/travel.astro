---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Travel">

<section class="py-5">

<div class="container">

<h1 class="mb-5 text-center">
Travel Gallery
</h1>

<div class="row g-4">

<div class="col-md-4">
<img src="https://picsum.photos/500/500?11" class="img-fluid rounded shadow">
<h4 class="mt-3">Shimla</h4>
<p>Beautiful mountains and peaceful landscapes.</p>
</div>

<div class="col-md-4">
<img src="https://picsum.photos/500/500?12" class="img-fluid rounded shadow">
<h4 class="mt-3">Manali</h4>
<p>Snow-covered peaks and adventure activities.</p>
</div>

<div class="col-md-4">
<img src="https://picsum.photos/500/500?13" class="img-fluid rounded shadow">
<h4 class="mt-3">Kasol</h4>
<p>Nature, rivers, and breathtaking scenery.</p>
</div>

</div>

</div>

</section>

</MainLayout>